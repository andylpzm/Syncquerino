rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // helper functions for authorization and input validation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return isAuthenticated() && 
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // users profile collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
    }

    // household groups collection
    match /groups/{groupId} {
      // allow read to group members or when querying by room code
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.members || resource == null);
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && 
        (request.auth.uid == resource.data.createdBy || request.auth.uid in resource.data.members);
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.createdBy;
    }

    // shared items collection (groceries, chores, whiteboard notes)
    match /items/{itemId} {
      allow read: if isAuthenticated() && isGroupMember(resource.data.groupId);
      allow create: if isAuthenticated() && isGroupMember(request.resource.data.groupId);
      allow update, delete: if isAuthenticated() && isGroupMember(resource.data.groupId);
    }
  }
}
